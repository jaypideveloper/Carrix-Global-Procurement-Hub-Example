:root {
    --bg: #0B1019;
    --surface-1: #121A28;
    --surface-2: #182233;
    --surface-3: #212D42;
    --border: rgba(255, 255, 255, 0.08);
    --border-strong: rgba(255, 255, 255, 0.16);
    --text-1: #F3F6FA;
    --text-2: #B9C3D3;
    --text-3: #7F8BA0;
    --accent: #3987E5;
    --accent-hover: #4B95EC;
    --accent-soft: rgba(57, 135, 229, 0.16);
    --series-1: #3987E5;
    --series-2: #D95926;
    --series-3: #199E70;
    --series-4: #C98500;
    --neutral-series: #C3C2B7;
    --good: #0CA30C;
    --warning: #FAB219;
    --serious: #EC835A;
    --critical: #D03B3B;

    --unity-colors-default-text: #F3F6FA;
    --unity-colors-label-text: #B9C3D3;
    --unity-colors-input_field-background: #182233;
    --unity-colors-input_field-border: rgba(255, 255, 255, 0.16);
    --unity-colors-input_field-border-focus: #3987E5;
    --unity-colors-input_field-border-hover: rgba(255, 255, 255, 0.28);
    --unity-colors-dropdown-background: #182233;
    --unity-colors-dropdown-border: rgba(255, 255, 255, 0.16);
    --unity-colors-dropdown-text: #F3F6FA;
    --unity-colors-button-background: #212D42;
    --unity-colors-button-text: #F3F6FA;
    --unity-colors-highlight-background: rgba(57, 135, 229, 0.35);

    font-size: 13px;
    color: #F3F6FA;
}

/* ---------------------------------------------------------------- shell */

.app {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    flex-direction: row;
    background-color: var(--bg);
}

.sidebar {
    width: 232px;
    background-color: #0E1521;
    border-right-width: 1px;
    border-right-color: var(--border);
    padding: 18px 12px 14px 12px;
}

.brand {
    flex-direction: row;
    align-items: center;
    padding: 0 8px 18px 8px;
    border-bottom-width: 1px;
    border-bottom-color: var(--border);
    margin-bottom: 12px;
}

.brand-mark {
    width: 34px;
    height: 34px;
    border-radius: 8px;
    background-color: var(--accent);
    margin-right: 10px;
    align-items: center;
    justify-content: center;
}

.brand-mark-label {
    -unity-font-style: bold;
    font-size: 13px;
    color: #FFFFFF;
    -unity-text-align: middle-center;
}

.brand-title {
    -unity-font-style: bold;
    font-size: 13px;
    color: var(--text-1);
}

.brand-sub {
    font-size: 11px;
    color: var(--text-3);
    margin-top: 1px;
}

.nav-section {
    font-size: 10px;
    color: var(--text-3);
    -unity-font-style: bold;
    letter-spacing: 1px;
    margin: 14px 10px 6px 10px;
}

.nav-item {
    flex-direction: row;
    align-items: center;
    height: 36px;
    padding: 0 10px;
    margin: 1px 0;
    border-radius: 8px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    transition-duration: 0.12s;
}

.nav-item:hover {
    background-color: rgba(255, 255, 255, 0.05);
}

.nav-item--active {
    background-color: var(--accent-soft);
}

.nav-item--active:hover {
    background-color: var(--accent-soft);
}

.nav-icon {
    width: 16px;
    height: 16px;
    margin-right: 11px;
}

.nav-label {
    flex-grow: 1;
    color: var(--text-2);
    font-size: 13px;
}

.nav-item--active > .nav-label {
    color: var(--text-1);
    -unity-font-style: bold;
}

.nav-badge {
    min-width: 20px;
    height: 18px;
    border-radius: 9px;
    background-color: var(--critical);
    color: #FFFFFF;
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    padding: 0 5px;
}

.sidebar-spacer {
    flex-grow: 1;
}

.sidebar-footer {
    border-top-width: 1px;
    border-top-color: var(--border);
    padding: 12px 6px 0 6px;
}

.persona {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
}

.avatar {
    width: 30px;
    height: 30px;
    border-radius: 15px;
    background-color: var(--surface-3);
    align-items: center;
    justify-content: center;
    margin-right: 9px;
}

.avatar-label {
    font-size: 11px;
    -unity-font-style: bold;
    color: var(--text-1);
    -unity-text-align: middle-center;
}

.avatar--accent {
    background-color: var(--accent);
}

.persona-name {
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--text-1);
}

.persona-title {
    font-size: 11px;
    color: var(--text-3);
    white-space: normal;
}

.disclaimer {
    font-size: 10px;
    color: var(--text-3);
    white-space: normal;
    margin-top: 8px;
}

.main {
    flex-grow: 1;
    flex-shrink: 1;
}

.topbar {
    height: 62px;
    flex-direction: row;
    align-items: center;
    padding: 0 24px;
    border-bottom-width: 1px;
    border-bottom-color: var(--border);
    flex-shrink: 0;
}

.topbar-titles {
    flex-grow: 1;
}

.page-title {
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--text-1);
}

.page-subtitle {
    font-size: 12px;
    color: var(--text-3);
    margin-top: 2px;
}

.topbar-meta {
    flex-direction: row;
    align-items: center;
}

.meta-chip {
    flex-direction: row;
    align-items: center;
    height: 28px;
    padding: 0 10px;
    border-radius: 14px;
    background-color: var(--surface-1);
    border-width: 1px;
    border-color: var(--border);
    margin-left: 8px;
}

.meta-chip-label {
    font-size: 11px;
    color: var(--text-2);
}

.page-host {
    flex-grow: 1;
    flex-shrink: 1;
}

.page {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.page-scroll {
    flex-grow: 1;
}

.page-scroll > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container {
    padding: 20px 24px 28px 24px;
}

/* ---------------------------------------------------------------- layout helpers */

.row {
    flex-direction: row;
}

.row-center {
    flex-direction: row;
    align-items: center;
}

.grow {
    flex-grow: 1;
    flex-shrink: 1;
}

.spacer {
    flex-grow: 1;
}

.gap-right {
    margin-right: 16px;
}

.gap-bottom {
    margin-bottom: 16px;
}

.mt-8 {
    margin-top: 8px;
}

.mt-12 {
    margin-top: 12px;
}

.mt-16 {
    margin-top: 16px;
}

.hidden {
    display: none;
}

/* ---------------------------------------------------------------- cards */

.card {
    background-color: var(--surface-1);
    border-width: 1px;
    border-color: var(--border);
    border-radius: 12px;
    padding: 16px;
}

.card--flush {
    padding: 0;
}

.card-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
}

.card-title {
    font-size: 13px;
    -unity-font-style: bold;
    color: var(--text-1);
}

.card-subtitle {
    font-size: 11px;
    color: var(--text-3);
    margin-top: 2px;
    white-space: normal;
}

.card-titles {
    flex-grow: 1;
    flex-shrink: 1;
}

.section-label {
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: var(--text-3);
    margin: 14px 0 6px 0;
}

.text-1 {
    color: var(--text-1);
}

.text-2 {
    color: var(--text-2);
}

.muted {
    color: var(--text-3);
}

.small {
    font-size: 11px;
}

.strong {
    -unity-font-style: bold;
}

.wrap {
    white-space: normal;
}

.body-text {
    color: var(--text-2);
    white-space: normal;
    font-size: 12px;
}

.divider {
    height: 1px;
    background-color: var(--border);
    margin: 12px 0;
}

/* ---------------------------------------------------------------- KPI tiles */

.kpi-row {
    flex-direction: row;
    margin-bottom: 16px;
}

.kpi {
    flex-grow: 1;
    flex-basis: 0;
    background-color: var(--surface-1);
    border-width: 1px;
    border-color: var(--border);
    border-radius: 12px;
    padding: 12px 14px;
    margin-right: 12px;
    min-width: 120px;
}

.kpi--last {
    margin-right: 0;
}

.kpi--glass {
    background-color: rgba(18, 26, 40, 0.86);
}

.kpi-label {
    font-size: 11px;
    color: var(--text-3);
}

.kpi-value {
    font-size: 22px;
    -unity-font-style: bold;
    color: var(--text-1);
    margin-top: 4px;
}

.kpi-note {
    font-size: 11px;
    color: var(--text-3);
    margin-top: 2px;
    white-space: normal;
}

.kpi-spark {
    height: 26px;
    margin-top: 6px;
}

/* ---------------------------------------------------------------- buttons */

.btn {
    height: 32px;
    padding: 0 14px;
    margin: 0;
    border-width: 1px;
    border-color: var(--border-strong);
    border-radius: 8px;
    background-color: var(--surface-2);
    color: var(--text-1);
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    transition-duration: 0.12s;
}

.btn:hover {
    background-color: var(--surface-3);
    border-color: rgba(255, 255, 255, 0.24);
}

.btn:active {
    background-color: #2A3850;
}

.btn:disabled {
    opacity: 0.45;
}

.btn--primary {
    background-color: var(--accent);
    border-color: var(--accent);
    color: #FFFFFF;
}

.btn--primary:hover {
    background-color: var(--accent-hover);
    border-color: var(--accent-hover);
}

.btn--danger {
    background-color: rgba(208, 59, 59, 0.14);
    border-color: rgba(208, 59, 59, 0.5);
    color: #F3B4B4;
}

.btn--danger:hover {
    background-color: rgba(208, 59, 59, 0.24);
    border-color: rgba(208, 59, 59, 0.7);
}

.btn--ghost {
    background-color: rgba(0, 0, 0, 0);
    border-color: rgba(0, 0, 0, 0);
    color: var(--text-2);
}

.btn--ghost:hover {
    background-color: rgba(255, 255, 255, 0.06);
    border-color: rgba(0, 0, 0, 0);
}

.btn--small {
    height: 26px;
    padding: 0 10px;
    font-size: 11px;
}

.btn-row {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
}

.btn-row > .btn {
    margin: 0 8px 6px 0;
}

/* ---------------------------------------------------------------- chips & segmented controls */

.chip-row {
    flex-direction: row;
    flex-wrap: wrap;
}

.chip {
    flex-direction: row;
    align-items: center;
    height: 28px;
    padding: 0 11px;
    margin: 0 6px 6px 0;
    border-radius: 14px;
    border-width: 1px;
    border-color: var(--border-strong);
    background-color: rgba(0, 0, 0, 0);
    transition-duration: 0.12s;
}

.chip:hover {
    background-color: rgba(255, 255, 255, 0.05);
}

.chip--active {
    background-color: var(--accent-soft);
    border-color: var(--accent);
}

.chip--active:hover {
    background-color: var(--accent-soft);
}

.chip-label {
    font-size: 12px;
    color: var(--text-2);
}

.chip--active > .chip-label {
    color: var(--text-1);
}

.chip-dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    margin-right: 7px;
}

.segmented {
    flex-direction: row;
    background-color: var(--surface-2);
    border-radius: 8px;
    border-width: 1px;
    border-color: var(--border);
    padding: 2px;
    align-self: flex-start;
}

.segment {
    height: 26px;
    padding: 0 12px;
    border-radius: 6px;
    justify-content: center;
    transition-duration: 0.12s;
}

.segment:hover {
    background-color: rgba(255, 255, 255, 0.05);
}

.segment--active {
    background-color: var(--surface-3);
}

.segment--active:hover {
    background-color: var(--surface-3);
}

.segment-label {
    font-size: 12px;
    color: var(--text-3);
    -unity-text-align: middle-center;
}

.segment--active > .segment-label {
    color: var(--text-1);
    -unity-font-style: bold;
}

.segment--emergency.segment--active {
    background-color: rgba(208, 59, 59, 0.3);
}

/* ---------------------------------------------------------------- switch */

.switch {
    flex-direction: row;
    align-items: center;
    margin: 6px 0;
}

.switch-track {
    width: 34px;
    height: 20px;
    border-radius: 10px;
    background-color: var(--surface-3);
    border-width: 1px;
    border-color: var(--border-strong);
    padding: 2px;
    transition-duration: 0.15s;
}

.switch-knob {
    width: 14px;
    height: 14px;
    border-radius: 7px;
    background-color: var(--text-2);
    transition-duration: 0.15s;
}

.switch--on > .switch-track {
    background-color: var(--accent);
    border-color: var(--accent);
}

.switch--on > .switch-track > .switch-knob {
    translate: 14px 0;
    background-color: #FFFFFF;
}

.switch-label {
    margin-left: 10px;
    color: var(--text-2);
    font-size: 12px;
    white-space: normal;
    flex-shrink: 1;
}

/* ---------------------------------------------------------------- form fields */

.field {
    margin-bottom: 14px;
}

.field-label {
    font-size: 11px;
    color: var(--text-3);
    -unity-font-style: bold;
    margin-bottom: 6px;
}

.field-hint {
    font-size: 11px;
    color: var(--text-3);
    margin-top: 5px;
    white-space: normal;
}

.hub-input {
    margin: 0;
}

.hub-input > .unity-base-text-field__input,
.hub-input > .unity-base-popup-field__input {
    min-height: 34px;
    background-color: var(--surface-2);
    border-width: 1px;
    border-color: var(--border-strong);
    border-radius: 8px;
    padding: 0 10px;
    color: var(--text-1);
    font-size: 13px;
}

.hub-input > .unity-base-text-field__input:hover,
.hub-input > .unity-base-popup-field__input:hover {
    border-color: rgba(255, 255, 255, 0.28);
}

.hub-input:focus > .unity-base-text-field__input {
    border-color: var(--accent);
}

.hub-input--multiline > .unity-base-text-field__input {
    min-height: 70px;
    padding: 8px 10px;
    -unity-text-align: upper-left;
    white-space: normal;
}

.hub-input > .unity-base-text-field__input--placeholder {
    color: var(--text-3);
}

.hub-input .unity-base-text-field__input--placeholder > .unity-text-element {
    color: var(--text-3);
}

.hub-input .unity-base-popup-field__arrow {
    -unity-background-image-tint-color: var(--text-2);
}

.hub-input--search > .unity-base-text-field__input {
    min-height: 32px;
}

.unity-base-dropdown__container-outer {
    background-color: var(--surface-2);
    border-width: 1px;
    border-color: var(--border-strong);
    border-radius: 8px;
}

.unity-base-dropdown__container-inner {
    background-color: var(--surface-2);
    border-width: 0;
}

.unity-base-dropdown__item {
    height: 28px;
    background-color: var(--surface-2);
}

.unity-base-dropdown__item:hover {
    background-color: var(--surface-3);
}

.unity-base-dropdown__label {
    color: var(--text-1);
    font-size: 12px;
}

.unity-base-dropdown__checkmark {
    -unity-background-image-tint-color: var(--accent);
}

.unity-base-slider__tracker {
    background-color: var(--surface-3);
    border-color: var(--border);
}

.unity-base-slider__dragger {
    background-color: var(--accent);
    border-color: var(--accent);
}

.unity-base-slider__dragger-border {
    border-color: rgba(0, 0, 0, 0);
}

.unity-scroller--vertical {
    width: 10px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.unity-scroller--horizontal {
    height: 10px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.unity-scroller .unity-repeat-button {
    display: none;
}

.unity-scroller .unity-base-slider__tracker {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.unity-scroller .unity-base-slider__dragger {
    background-color: rgba(255, 255, 255, 0.14);
    border-width: 0;
    border-radius: 4px;
}

.unity-scroller .unity-base-slider__dragger:hover {
    background-color: rgba(255, 255, 255, 0.24);
}

/* ---------------------------------------------------------------- pills & status */

.pill {
    flex-direction: row;
    align-items: center;
    align-self: flex-start;
    height: 22px;
    padding: 0 9px;
    border-radius: 11px;
    background-color: var(--surface-3);
}

.pill-label {
    font-size: 11px;
    color: var(--text-1);
    -unity-font-style: bold;
}

.dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    margin-right: 6px;
    flex-shrink: 0;
}

.dot--good {
    background-color: var(--good);
}

.dot--warning {
    background-color: var(--warning);
}

.dot--serious {
    background-color: var(--serious);
}

.dot--critical {
    background-color: var(--critical);
}

.dot--info {
    background-color: var(--accent);
}

.dot--neutral {
    background-color: var(--text-3);
}

.pill--good {
    background-color: rgba(12, 163, 12, 0.18);
}

.pill--warning {
    background-color: rgba(250, 178, 25, 0.16);
}

.pill--serious {
    background-color: rgba(236, 131, 90, 0.18);
}

.pill--critical {
    background-color: rgba(208, 59, 59, 0.22);
}

.pill--info {
    background-color: var(--accent-soft);
}

/* ---------------------------------------------------------------- tables */

.table {
    flex-grow: 1;
    flex-shrink: 1;
}

.table-header {
    flex-direction: row;
    height: 34px;
    align-items: center;
    padding: 0 20px 0 10px;
    border-bottom-width: 1px;
    border-bottom-color: var(--border);
    flex-shrink: 0;
}

.th {
    font-size: 11px;
    -unity-font-style: bold;
    color: var(--text-3);
    padding: 0 6px;
    overflow: hidden;
    text-overflow: ellipsis;
}

.th--sortable:hover {
    color: var(--text-1);
}

.th--sorted {
    color: var(--text-1);
}

.table-body {
    flex-grow: 1;
}

.tr {
    flex-direction: row;
    align-items: center;
    height: 100%;
    padding: 0 10px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.04);
}

.td {
    flex-direction: row;
    align-items: center;
    padding: 0 6px;
    overflow: hidden;
}

.td-label {
    font-size: 12px;
    color: var(--text-2);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    flex-shrink: 1;
}

.td--right {
    justify-content: flex-end;
}

.td--right > .td-label {
    -unity-text-align: middle-right;
}

.td--strong > .td-label {
    color: var(--text-1);
    -unity-font-style: bold;
}

.td--muted > .td-label {
    color: var(--text-3);
}

.th--right {
    -unity-text-align: middle-right;
}

.unity-list-view__item {
    background-color: rgba(0, 0, 0, 0);
}

.unity-list-view__item:hover {
    background-color: rgba(255, 255, 255, 0.035);
}

.unity-collection-view__item--selected,
.unity-list-view__item--selected {
    background-color: rgba(57, 135, 229, 0.18);
}

.unity-collection-view__item--selected:hover {
    background-color: rgba(57, 135, 229, 0.22);
}

.unity-list-view__empty-label {
    color: var(--text-3);
    font-size: 12px;
}

/* ---------------------------------------------------------------- charts */

.chart {
    flex-grow: 1;
}

.chart-plot-row {
    flex-direction: row;
    flex-grow: 1;
}

.chart-yaxis {
    width: 46px;
}

.chart-plot {
    flex-grow: 1;
    border-bottom-width: 1px;
    border-bottom-color: #383835;
}

.chart-grid {
    position: absolute;
    left: 0;
    right: 0;
    height: 1px;
    background-color: rgba(255, 255, 255, 0.06);
}

.chart-tick {
    position: absolute;
    right: 6px;
    font-size: 10px;
    color: var(--text-3);
    -unity-text-align: middle-right;
}

.chart-columns {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    flex-direction: row;
    align-items: flex-end;
}

.chart-col {
    flex-grow: 1;
    flex-basis: 0;
    height: 100%;
    justify-content: flex-end;
    margin: 0 3px;
    border-radius: 3px;
}

.chart-col:hover {
    background-color: rgba(255, 255, 255, 0.04);
}

.chart-seg {
    margin-top: 2px;
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
}

.chart-xaxis {
    flex-direction: row;
    margin-left: 46px;
    height: 20px;
}

.chart-xlabel {
    flex-grow: 1;
    flex-basis: 0;
    font-size: 10px;
    color: var(--text-3);
    -unity-text-align: middle-center;
}

.legend {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 8px;
}

.legend-item {
    flex-direction: row;
    align-items: center;
    margin-right: 14px;
    margin-bottom: 2px;
}

.legend-swatch {
    width: 10px;
    height: 10px;
    border-radius: 3px;
    margin-right: 6px;
}

.legend-label {
    font-size: 11px;
    color: var(--text-2);
}

.bar-row {
    flex-direction: row;
    align-items: center;
    height: 26px;
    border-radius: 6px;
    padding: 0 4px;
}

.bar-row:hover {
    background-color: rgba(255, 255, 255, 0.04);
}

.bar-row--clickable:hover {
    background-color: rgba(57, 135, 229, 0.10);
}

.bar-label {
    width: 150px;
    font-size: 12px;
    color: var(--text-2);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.bar-track {
    flex-grow: 1;
    height: 10px;
    margin: 0 10px;
}

.bar-fill {
    height: 100%;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    background-color: var(--series-1);
}

.bar-marker {
    position: absolute;
    width: 2px;
    top: -4px;
    bottom: -4px;
    background-color: var(--text-1);
}

.bar-value {
    width: 64px;
    font-size: 12px;
    color: var(--text-1);
    -unity-text-align: middle-right;
}

.bar-extra {
    width: 46px;
    font-size: 11px;
    color: var(--text-3);
    -unity-text-align: middle-right;
}

.heatmap-row {
    flex-direction: row;
    height: 28px;
    align-items: center;
}

.heatmap-rowlabel {
    width: 118px;
    font-size: 11px;
    color: var(--text-2);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.heatmap-cell {
    flex-grow: 1;
    flex-basis: 0;
    height: 24px;
    margin: 1px;
    border-radius: 3px;
    justify-content: center;
}

.heatmap-cell:hover {
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.6);
}

.heatmap-value {
    font-size: 10px;
    -unity-text-align: middle-center;
    color: rgba(255, 255, 255, 0.85);
}

.heatmap-value--dark {
    color: #0B1019;
}

.heatmap-collabel {
    flex-grow: 1;
    flex-basis: 0;
    font-size: 10px;
    color: var(--text-3);
    -unity-text-align: middle-center;
    margin: 0 1px;
}

.scale-row {
    flex-direction: row;
    align-items: center;
    margin-top: 10px;
}

.scale-swatch {
    width: 22px;
    height: 8px;
}

.progress {
    height: 6px;
    border-radius: 3px;
    background-color: var(--surface-3);
    overflow: hidden;
}

.progress-fill {
    height: 100%;
    border-radius: 3px;
    background-color: var(--accent);
}

/* ---------------------------------------------------------------- globe */

.cc-left {
    width: 320px;
    border-right-width: 1px;
    border-right-color: var(--border);
}

.cc-right {
    width: 350px;
    border-left-width: 1px;
    border-left-color: var(--border);
}

.cc-center {
    flex-grow: 1;
    flex-shrink: 1;
}

.cc-kpis {
    flex-direction: row;
    padding: 16px 16px 0 16px;
    flex-shrink: 0;
}

.cc-stage {
    flex-grow: 1;
    flex-shrink: 1;
}

.side-scroll > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container {
    padding: 16px;
}

.globe-viewport {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: stretch-to-fill;
}

.globe-overlay-top {
    position: absolute;
    left: 16px;
    right: 16px;
    top: 16px;
    flex-direction: row;
}

.globe-legend {
    position: absolute;
    left: 16px;
    bottom: 16px;
    padding: 10px 12px;
    border-radius: 10px;
    background-color: rgba(18, 26, 40, 0.86);
    border-width: 1px;
    border-color: var(--border);
}

.globe-hint {
    position: absolute;
    right: 16px;
    bottom: 16px;
    font-size: 11px;
    color: var(--text-3);
    background-color: rgba(18, 26, 40, 0.7);
    border-radius: 8px;
    padding: 6px 10px;
}

.globe-tools {
    position: absolute;
    right: 16px;
    top: 14px;
    flex-direction: row;
}

.globe-tip {
    position: absolute;
    padding: 8px 10px;
    border-radius: 8px;
    background-color: rgba(11, 16, 25, 0.94);
    border-width: 1px;
    border-color: var(--border-strong);
    max-width: 260px;
}

.globe-tip-title {
    -unity-font-style: bold;
    color: var(--text-1);
    font-size: 12px;
}

.globe-tip-sub {
    color: var(--text-3);
    font-size: 11px;
    margin-top: 2px;
}

.stat-grid {
    flex-direction: row;
    flex-wrap: wrap;
    margin: 4px -4px 0 -4px;
}

.stat {
    width: 50%;
    padding: 4px;
}

.stat-inner {
    background-color: var(--surface-2);
    border-radius: 8px;
    padding: 9px 10px;
}

.stat-label {
    font-size: 10px;
    color: var(--text-3);
}

.stat-value {
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--text-1);
    margin-top: 2px;
}

.kv {
    flex-direction: row;
    justify-content: space-between;
    padding: 4px 0;
}

.kv-key {
    font-size: 12px;
    color: var(--text-3);
    flex-shrink: 0;
    margin-right: 12px;
}

.kv-value {
    font-size: 12px;
    color: var(--text-1);
    -unity-text-align: middle-right;
    white-space: normal;
    flex-shrink: 1;
}

/* ---------------------------------------------------------------- alerts */

.alert-item {
    padding: 11px 12px;
    border-radius: 10px;
    background-color: var(--surface-2);
    margin-bottom: 8px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
    transition-duration: 0.12s;
}

.alert-item:hover {
    border-color: var(--border-strong);
}

.alert-item--selected {
    border-color: var(--accent);
}

.alert-item--resolved {
    opacity: 0.5;
}

.alert-head {
    flex-direction: row;
    align-items: center;
    margin-bottom: 5px;
}

.alert-sev {
    font-size: 10px;
    -unity-font-style: bold;
    color: var(--text-2);
    letter-spacing: 0.5px;
}

.alert-type {
    font-size: 10px;
    color: var(--text-3);
    margin-left: 6px;
}

.alert-title {
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--text-1);
    white-space: normal;
}

.alert-detail {
    font-size: 11px;
    color: var(--text-2);
    white-space: normal;
    margin-top: 4px;
}

.alert-rec {
    font-size: 11px;
    color: var(--text-1);
    white-space: normal;
    margin-top: 8px;
    padding: 8px;
    border-radius: 6px;
    background-color: rgba(57, 135, 229, 0.10);
}

.alert-foot {
    flex-direction: row;
    align-items: center;
    margin-top: 8px;
}

.alert-impact {
    font-size: 11px;
    -unity-font-style: bold;
    color: var(--text-1);
}

.alert-meta {
    font-size: 10px;
    color: var(--text-3);
    margin-left: 8px;
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

/* ---------------------------------------------------------------- intake & decision panel */

.intake-form {
    flex-grow: 1;
    flex-shrink: 1;
}

.decision-panel {
    width: 480px;
    border-left-width: 1px;
    border-left-color: var(--border);
    background-color: #0E1521;
}

.form-grid {
    flex-direction: row;
}

.form-col {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 12px;
}

.form-col--last {
    margin-right: 0;
}

.total-box {
    background-color: var(--surface-2);
    border-radius: 8px;
    padding: 6px 12px;
    min-height: 34px;
    justify-content: center;
}

.total-value {
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--text-1);
}

.example-chip {
    height: 30px;
    padding: 0 12px;
    margin: 0 6px 6px 0;
    border-radius: 15px;
    background-color: var(--surface-2);
    border-width: 1px;
    border-color: var(--border);
    justify-content: center;
    transition-duration: 0.12s;
}

.example-chip:hover {
    border-color: var(--accent);
    background-color: var(--accent-soft);
}

.example-chip-label {
    font-size: 11px;
    color: var(--text-2);
}

.decision-banner {
    border-radius: 12px;
    padding: 14px 16px;
    margin-bottom: 14px;
    border-width: 1px;
}

.decision-banner--required {
    background-color: rgba(250, 178, 25, 0.10);
    border-color: rgba(250, 178, 25, 0.4);
}

.decision-banner--selfserve {
    background-color: rgba(12, 163, 12, 0.10);
    border-color: rgba(12, 163, 12, 0.4);
}

.decision-banner--emergency {
    background-color: rgba(208, 59, 59, 0.12);
    border-color: rgba(208, 59, 59, 0.5);
}

.decision-banner--idle {
    background-color: var(--surface-1);
    border-color: var(--border);
}

.decision-kicker {
    font-size: 10px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    color: var(--text-3);
}

.decision-title {
    font-size: 17px;
    -unity-font-style: bold;
    color: var(--text-1);
    margin-top: 4px;
    white-space: normal;
}

.decision-summary {
    font-size: 12px;
    color: var(--text-2);
    margin-top: 6px;
    white-space: normal;
}

.rule-row {
    flex-direction: row;
    padding: 9px 0;
    border-bottom-width: 1px;
    border-bottom-color: var(--border);
}

.rule-row--last {
    border-bottom-width: 0;
}

.rule-icon {
    width: 18px;
    height: 18px;
    margin-right: 10px;
    margin-top: 1px;
    flex-shrink: 0;
}

.rule-title {
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--text-1);
}

.rule-state {
    font-size: 10px;
    -unity-font-style: bold;
    margin-left: 8px;
    color: var(--text-3);
}

.rule-detail {
    font-size: 11px;
    color: var(--text-2);
    white-space: normal;
    margin-top: 3px;
}

.conf-row {
    margin-bottom: 9px;
}

.conf-head {
    flex-direction: row;
    margin-bottom: 4px;
}

.conf-name {
    flex-grow: 1;
    font-size: 12px;
    color: var(--text-1);
}

.conf-name--top {
    -unity-font-style: bold;
}

.conf-pct {
    font-size: 12px;
    color: var(--text-2);
}

.conf-evidence {
    font-size: 10px;
    color: var(--text-3);
    white-space: normal;
    margin-top: 3px;
}

.approval-step {
    flex-direction: row;
    align-items: center;
    padding: 6px 0;
}

.approval-num {
    width: 20px;
    height: 20px;
    border-radius: 10px;
    background-color: var(--surface-3);
    font-size: 10px;
    -unity-font-style: bold;
    color: var(--text-1);
    -unity-text-align: middle-center;
    margin-right: 10px;
}

.option-card {
    background-color: var(--surface-2);
    border-radius: 10px;
    padding: 11px 12px;
    margin-bottom: 8px;
    border-width: 1px;
    border-color: var(--border);
}

.option-card--best {
    border-color: rgba(57, 135, 229, 0.6);
}

.option-title {
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--text-1);
}

.option-sub {
    font-size: 11px;
    color: var(--text-3);
    margin-top: 2px;
    white-space: normal;
}

.option-price {
    font-size: 13px;
    -unity-font-style: bold;
    color: var(--text-1);
}

.savings {
    font-size: 11px;
    color: #56C856;
    -unity-font-style: bold;
}

.range {
    height: 40px;
    margin: 18px 6px 4px 6px;
}

.range-track {
    position: absolute;
    left: 0;
    right: 0;
    top: 16px;
    height: 6px;
    border-radius: 3px;
    background-color: var(--surface-3);
}

.range-band {
    position: absolute;
    top: 16px;
    height: 6px;
    border-radius: 3px;
    background-color: rgba(57, 135, 229, 0.55);
}

.range-marker {
    position: absolute;
    top: 8px;
    width: 3px;
    height: 22px;
    border-radius: 1px;
    margin-left: -1px;
}

.range-marker-label {
    position: absolute;
    font-size: 10px;
    color: var(--text-2);
    width: 120px;
    margin-left: -60px;
    -unity-text-align: middle-center;
}

.assistant-card {
    border-color: rgba(57, 135, 229, 0.45);
    background-color: rgba(57, 135, 229, 0.07);
}

.assistant-headline {
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--text-1);
    white-space: normal;
}

.bullet {
    flex-direction: row;
    margin-top: 6px;
}

.bullet-mark {
    width: 14px;
    font-size: 12px;
    color: var(--text-3);
    flex-shrink: 0;
}

.bullet-text {
    font-size: 12px;
    color: var(--text-2);
    white-space: normal;
    flex-shrink: 1;
}

.bullet--risk > .bullet-mark {
    color: var(--warning);
}

.check-text {
    font-size: 10px;
    color: var(--text-3);
    white-space: normal;
}

.human-gate {
    flex-direction: row;
    align-items: center;
    margin-top: 12px;
    padding-top: 12px;
    border-top-width: 1px;
    border-top-color: var(--border);
}

.gate-state {
    font-size: 11px;
    color: var(--text-2);
    flex-grow: 1;
    flex-shrink: 1;
    white-space: normal;
}

.ai-answer {
    margin-top: 10px;
    padding: 10px;
    border-radius: 8px;
    background-color: var(--surface-2);
    font-size: 12px;
    color: var(--text-1);
    white-space: normal;
}

/* ---------------------------------------------------------------- requests */

.filter-bar {
    flex-direction: row;
    align-items: center;
    padding: 14px 24px;
    border-bottom-width: 1px;
    border-bottom-color: var(--border);
    flex-shrink: 0;
}

.filter-item {
    margin-right: 10px;
}

.filter-search {
    width: 260px;
}

.filter-drop {
    width: 196px;
}

.count-label {
    font-size: 12px;
    color: var(--text-3);
}

.split {
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 1;
}

.table-pane {
    flex-grow: 1;
    flex-shrink: 1;
}

.detail-pane {
    width: 470px;
    border-left-width: 1px;
    border-left-color: var(--border);
    background-color: #0E1521;
}

.detail-title {
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--text-1);
    white-space: normal;
    margin-top: 8px;
}

.empty-state {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    padding: 40px;
}

.empty-title {
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--text-2);
    -unity-text-align: middle-center;
}

.empty-sub {
    font-size: 12px;
    color: var(--text-3);
    -unity-text-align: middle-center;
    white-space: normal;
    margin-top: 6px;
}

.timeline-step {
    flex-direction: row;
    min-height: 40px;
}

.timeline-rail {
    width: 22px;
    align-items: center;
}

.timeline-node {
    width: 12px;
    height: 12px;
    border-radius: 6px;
    border-width: 2px;
    border-color: var(--text-3);
    background-color: var(--bg);
    margin-top: 3px;
}

.timeline-node--done {
    background-color: var(--good);
    border-color: var(--good);
}

.timeline-node--current {
    background-color: var(--accent);
    border-color: #9EC5F4;
}

.timeline-node--rejected {
    background-color: var(--critical);
    border-color: var(--critical);
}

.timeline-line {
    width: 2px;
    flex-grow: 1;
    background-color: var(--border-strong);
    margin: 2px 0;
}

.timeline-body {
    flex-grow: 1;
    flex-shrink: 1;
    padding-left: 8px;
    padding-bottom: 10px;
}

.timeline-title {
    font-size: 12px;
    color: var(--text-3);
}

.timeline-title--done {
    color: var(--text-1);
}

.timeline-title--current {
    color: var(--text-1);
    -unity-font-style: bold;
}

.timeline-time {
    font-size: 10px;
    color: var(--text-3);
    margin-top: 1px;
}

.log-item {
    padding: 7px 0;
    border-bottom-width: 1px;
    border-bottom-color: var(--border);
}

.log-head {
    flex-direction: row;
}

.log-actor {
    font-size: 11px;
    -unity-font-style: bold;
    color: var(--text-1);
    flex-grow: 1;
}

.log-time {
    font-size: 10px;
    color: var(--text-3);
}

.log-note {
    font-size: 11px;
    color: var(--text-2);
    white-space: normal;
    margin-top: 2px;
}

/* ---------------------------------------------------------------- tabs */

.tabs {
    flex-direction: row;
    padding: 0 24px;
    border-bottom-width: 1px;
    border-bottom-color: var(--border);
    flex-shrink: 0;
}

.tab {
    height: 42px;
    padding: 0 4px;
    margin-right: 22px;
    justify-content: center;
    border-bottom-width: 2px;
    border-bottom-color: rgba(0, 0, 0, 0);
}

.tab-label {
    font-size: 13px;
    color: var(--text-3);
}

.tab:hover > .tab-label {
    color: var(--text-1);
}

.tab--active {
    border-bottom-color: var(--accent);
}

.tab--active > .tab-label {
    color: var(--text-1);
    -unity-font-style: bold;
}

/* ---------------------------------------------------------------- SQL page */

.code-block {
    background-color: #080C13;
    border-radius: 10px;
    border-width: 1px;
    border-color: var(--border);
    padding: 14px;
}

.code-text {
    font-size: 12px;
    color: #CFE3FF;
    white-space: normal;
}

.table-card {
    padding: 10px 12px;
    border-radius: 10px;
    background-color: var(--surface-2);
    margin-bottom: 8px;
}

.table-name {
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--text-1);
}

.table-cols {
    font-size: 10px;
    color: var(--text-3);
    white-space: normal;
    margin-top: 4px;
}

.query-item {
    padding: 9px 12px;
    border-radius: 8px;
    margin-bottom: 4px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
}

.query-item:hover {
    background-color: rgba(255, 255, 255, 0.04);
}

.query-item--active {
    background-color: var(--accent-soft);
    border-color: rgba(57, 135, 229, 0.5);
}

.query-title {
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--text-1);
}

.query-question {
    font-size: 11px;
    color: var(--text-3);
    white-space: normal;
    margin-top: 2px;
}

/* ---------------------------------------------------------------- overlay: tooltip, toast, modal, loading */

.overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.tooltip {
    position: absolute;
    max-width: 300px;
    padding: 7px 10px;
    border-radius: 7px;
    background-color: rgba(8, 12, 19, 0.96);
    border-width: 1px;
    border-color: var(--border-strong);
    font-size: 11px;
    color: var(--text-1);
    white-space: normal;
}

.toast-stack {
    position: absolute;
    right: 20px;
    top: 74px;
    width: 360px;
}

.toast {
    flex-direction: row;
    align-items: flex-start;
    padding: 12px 14px;
    border-radius: 10px;
    background-color: #1B2638;
    border-width: 1px;
    border-color: var(--border-strong);
    margin-bottom: 8px;
    opacity: 1;
    transition-duration: 0.25s;
}

.toast--leaving {
    opacity: 0;
}

.toast-text {
    font-size: 12px;
    color: var(--text-1);
    white-space: normal;
    flex-shrink: 1;
}

.modal-backdrop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(3, 6, 10, 0.66);
    align-items: center;
    justify-content: center;
}

.modal {
    width: 460px;
    background-color: var(--surface-1);
    border-radius: 14px;
    border-width: 1px;
    border-color: var(--border-strong);
    padding: 20px;
}

.modal-title {
    font-size: 15px;
    -unity-font-style: bold;
    color: var(--text-1);
}

.modal-text {
    font-size: 12px;
    color: var(--text-2);
    white-space: normal;
    margin: 8px 0 14px 0;
}

.loading {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: var(--bg);
    align-items: center;
    justify-content: center;
}

.loading-title {
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--text-1);
    -unity-text-align: middle-center;
}

.loading-sub {
    font-size: 12px;
    color: var(--text-3);
    margin-top: 8px;
    -unity-text-align: middle-center;
}
